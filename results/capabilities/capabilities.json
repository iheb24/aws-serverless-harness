          "id": "s3-control-host-prefix",
          "summary": "Terraform's AWS provider calls S3 Control ListTagsForResource for bucket tagging; S3 Control requests always inject the account id into the endpoint host (000000000000.127.0.0.1), which AWS Emulator documents as unreachable — S3 bucket apply fails on aws-emulator.",
          "affects": [
            "s3:CreateBucket",
            "s3:DeleteBucket"
          ],
          "backends": [
            "aws-emulator"
          ],
          "reference": "https://docs.aws.amazon.com/emulator/latest/userguide/point-sdk-to-emulator.html",
          "observed_in": "v1.0.471.1+ (spike 2026-11-17, binary 1.0.481)",
          "workaround": "validate S3 bucket resources on real AWS (S3 Control is unreachable on local emulators)"
        }
